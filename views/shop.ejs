<%- include('./partials/header') %>

<div class="relative">

    <% if (locals.success && success.length > 0) { %>
    <div id="flash-success" class="fixed top-20 left-1/2 -translate-x-1/2 z-50 flex items-center gap-3 bg-green-500 text-white px-6 py-3 rounded-xl shadow-2xl border border-green-400 backdrop-blur-sm transition-all duration-300">
        <i class="ri-checkbox-circle-line text-xl"></i>
        <span class="font-medium"><%= success[0] %></span>
    </div>
    <script>
        setTimeout(function() {
            const el = document.getElementById('flash-success');
            if (el) {
                el.style.opacity = '0';
                el.style.transform = 'translateX(-50%) translateY(-10px)';
                el.style.transition = 'opacity 0.4s ease, transform 0.4s ease';
                setTimeout(() => el.remove(), 400);
            }
        }, 3000);
    </script>
    <% } %>

    <% if (locals.error && error.length > 0) { %>
    <div id="flash-error" class="fixed top-20 left-1/2 -translate-x-1/2 z-50 flex items-center gap-3 bg-red-500 text-white px-6 py-3 rounded-xl shadow-2xl border border-red-400 backdrop-blur-sm transition-all duration-300">
        <i class="ri-error-warning-line text-xl"></i>
        <span class="font-medium"><%= error[0] %></span>
    </div>
    <script>
        setTimeout(function() {
            const el = document.getElementById('flash-error');
            if (el) {
                el.style.opacity = '0';
                el.style.transform = 'translateX(-50%) translateY(-10px)';
                el.style.transition = 'opacity 0.4s ease, transform 0.4s ease';
                setTimeout(() => el.remove(), 400);
            }
        }, 3000);
    </script>
    <% } %>

    <div class="w-full min-h-screen flex items-start px-20 py-20">

        <div class="w-[25%] flex min-h-screen flex-col items-start">
            <div class="flex items-center gap-2">
                <h3>sort by</h3>
                <form action="/shop">
                    <select class="border-[1px] px-2 py-1" name="sortby" id="">
                        <option value="popular">Popular</option>
                        <option value="newest">Newest</option>
                    </select>
                </form>
            </div>
            <div class="flex flex-col mt-20">
                <a class="block w-fit mb-2" href="">New Collection</a>
                <a class="block w-fit mb-2" href="">All Products</a>
                <a class="block w-fit mb-2" href="">Discounted Products</a>
            </div>
            <div class="mt-32">
                <a class="block w-fit mb-2" href="">Filter by :</a>
                <a class="block w-fit mb-2" href="">Availability</a>
                <a class="block w-fit mb-2" href="">Discount</a>
            </div>
        </div>

        <div class="w-[75%] flex flex-col gap-5 min-h-screen">
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                <% products.forEach(function(product){ %>
                <div class="relative w-full rounded-lg overflow-hidden shadow-md hover:shadow-xl transition-shadow duration-300 group">

                    <a href="/addtocart/<%= product._id %>"
                       class="absolute top-3 right-3 z-10 h-10 w-10 rounded-full bg-white shadow-lg flex items-center justify-center hover:bg-zinc-100 hover:scale-110 transition-all duration-200">
                        <i class="ri-add-line text-lg text-gray-800"></i>
                    </a>

                    <div class="w-full h-52 flex items-center justify-center bg-[<%= product.bgcolor %>]">
                        <img class="h-[12rem] object-contain group-hover:scale-105 transition-transform duration-300"
                             src="<%= product.image ? 'data:image/jpeg;base64,' + product.image.toString('base64') : '' %>"
                             alt="<%= product.name %>">
                    </div>

                    <div class="flex justify-between bg-[<%= product.panelcolor %>] items-center px-4 py-4 text-[<%= product.textcolor %>]">
                        <div>
                            <h3 class="font-semibold text-base"><%= product.name %></h3>
                            <h4 class="text-sm opacity-80">₹ <%= product.price %></h4>
                        </div>
                        <% if (product.discount > 0) { %>
                        <span class="text-xs bg-green-100 text-green-700 font-semibold px-2 py-1 rounded-full">
                            -₹<%= product.discount %> off
                        </span>
                        <% } %>
                    </div>

                </div>
                <% }) %>
            </div>
        </div>

    </div>
</div>

<%- include('./partials/footer') %>