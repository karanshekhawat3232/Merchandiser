<%- include('./partials/header') %>

<% if (locals.success && success.length > 0) { %>
<div id="flash-success" class="fixed top-20 left-1/2 -translate-x-1/2 z-50 flex items-center gap-3 bg-green-500 text-white px-6 py-3 rounded-xl shadow-2xl border border-green-400">
    <i class="ri-checkbox-circle-line text-xl"></i>
    <span class="font-medium"><%= success[0] %></span>
</div>
<script>setTimeout(function(){var e=document.getElementById('flash-success');if(e){e.style.transition='opacity 0.4s';e.style.opacity='0';setTimeout(function(){e.remove()},400)}},3000);</script>
<% } %>

<% if (locals.error && error.length > 0) { %>
<div id="flash-error" class="fixed top-20 left-1/2 -translate-x-1/2 z-50 flex items-center gap-3 bg-red-500 text-white px-6 py-3 rounded-xl shadow-2xl border border-red-400">
    <i class="ri-error-warning-line text-xl"></i>
    <span class="font-medium"><%= error[0] %></span>
</div>
<script>setTimeout(function(){var e=document.getElementById('flash-error');if(e){e.style.transition='opacity 0.4s';e.style.opacity='0';setTimeout(function(){e.remove()},400)}},3000);</script>
<% } %>

<div class="w-full min-h-screen bg-gray-50 px-6 lg:px-16 pt-28 pb-16">

    <h1 class="text-2xl font-bold text-gray-800 mb-8">
        <i class="ri-shopping-cart-2-line mr-2 text-blue-500"></i>
        Shopping Cart
        <% if (groupedCart && groupedCart.length > 0) { %>
        <span class="ml-2 text-sm font-normal text-gray-400">(<%= groupedCart.length %> item<%= groupedCart.length !== 1 ? 's' : '' %>)</span>
        <% } %>
    </h1>

    <% if (!groupedCart || groupedCart.length === 0) { %>

        <div class="flex flex-col items-center justify-center bg-white rounded-2xl shadow-sm border border-gray-100 py-24 text-center">
            <div class="w-24 h-24 rounded-full bg-gray-100 flex items-center justify-center mb-6">
                <i class="ri-shopping-cart-2-line text-5xl text-gray-300"></i>
            </div>
            <h2 class="text-2xl font-semibold text-gray-600 mb-2">Your cart is empty</h2>
            <p class="text-gray-400 mb-8">Looks like you haven't added anything yet.</p>
            <a href="/shop" class="px-8 py-3 bg-blue-500 hover:bg-blue-600 text-white font-semibold rounded-full transition-colors shadow-sm">
                Browse Products
            </a>
        </div>

    <% } else { %>

    <div class="flex flex-col lg:flex-row gap-8 items-start">

        <div class="w-full lg:w-[65%] flex flex-col gap-4">

            <% groupedCart.forEach(function(entry) { %>
            <% var prod = entry.item; %>
            <% var qty = entry.quantity; %>
            <% var lineTotal = (Number(prod.price || 0) - Number(prod.discount || 0)) * qty; %>

            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-5 flex items-center gap-5 hover:shadow-md transition-shadow duration-200">

                <div class="w-24 h-24 flex-shrink-0 rounded-xl overflow-hidden flex items-center justify-center" style="background-color: <%= prod.bgcolor || '#f3f4f6' %>">
                    <img
                        class="w-full h-full object-contain"
                        src="<%= prod.image ? 'data:image/jpeg;base64,' + prod.image.toString('base64') : '' %>"
                        alt="<%= prod.name %>"
                    >
                </div>

                <div class="flex-1 min-w-0">
                    <h3 class="text-base font-semibold text-gray-800 truncate"><%= prod.name %></h3>
                    <% if (prod.category) { %>
                    <p class="text-xs text-gray-400 mt-0.5 capitalize"><%= prod.category %></p>
                    <% } %>
                    <div class="flex items-center gap-3 mt-2">
                        <span class="text-sm font-medium text-gray-700">MRP &#8377;<%= prod.price %></span>
                        <% if (prod.discount > 0) { %>
                        <span class="text-xs text-green-600 font-medium bg-green-50 px-2 py-0.5 rounded-full">
                            -&#8377;<%= prod.discount %> off
                        </span>
                        <% } %>
                    </div>
                </div>

                <div class="flex-shrink-0 flex items-center">
                    <div class="flex items-center gap-2 bg-gray-100 rounded-full px-4 py-1.5">
                        <span class="text-xs text-gray-500">Qty</span>
                        <span class="text-sm font-bold text-gray-800"><%= qty %></span>
                    </div>
                </div>

                <div class="flex-shrink-0 text-right min-w-[80px]">
                    <p class="text-xs text-gray-400 mb-0.5">Total</p>
                    <p class="text-base font-bold text-gray-800">&#8377;<%= lineTotal %></p>
                </div>

            </div>
            <% }) %>

            <a href="/shop" class="inline-flex items-center gap-2 text-sm text-blue-500 hover:text-blue-700 mt-2 transition-colors">
                <i class="ri-arrow-left-line"></i> Continue Shopping
            </a>

        </div>

        <div class="w-full lg:w-[35%] sticky top-24">
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-7">

                <h2 class="text-lg font-bold text-gray-800 mb-6 pb-4 border-b border-gray-100">
                    Order Summary
                </h2>

                <div class="space-y-3 text-sm">
                    <div class="flex justify-between text-gray-600">
                        <span>Total MRP</span>
                        <span class="font-medium text-gray-800">&#8377; <%= bill.totalMRP %></span>
                    </div>
                    <div class="flex justify-between text-gray-600">
                        <span>Discount on MRP</span>
                        <span class="font-semibold text-green-600">&#8722; &#8377; <%= bill.totalDiscount %></span>
                    </div>
                    <div class="flex justify-between text-gray-600">
                        <span>Platform Fee</span>
                        <span class="font-medium text-gray-800">&#8377; <%= bill.platformFee %></span>
                    </div>
                    <div class="flex justify-between text-gray-600">
                        <span>Shipping Fee</span>
                        <span class="font-semibold text-green-600">FREE</span>
                    </div>
                </div>

                <div class="mt-6 pt-5 border-t-2 border-gray-100 flex justify-between items-center">
                    <span class="text-base font-bold text-gray-800">Total Amount</span>
                    <span class="text-2xl font-extrabold text-green-600">&#8377; <%= bill.totalAmount %></span>
                </div>

                <% if (bill.totalDiscount > 0) { %>
                <div class="mt-3 bg-green-50 border border-green-100 rounded-xl px-4 py-2 text-center">
                    <span class="text-xs text-green-700 font-medium">
                        You are saving &#8377;<%= bill.totalDiscount %> on this order!
                    </span>
                </div>
                <% } %>

                <form action="/checkout" method="POST" class="mt-6">
                    <button type="submit"
                        class="w-full py-4 bg-green-600 hover:bg-green-700 active:bg-green-800 text-white font-bold text-base rounded-xl transition-colors shadow-sm hover:shadow-md">
                        Proceed to Payment
                    </button>
                </form>

            </div>
        </div>

    </div>
    <% } %>

</div>

<%- include('./partials/footer') %>
