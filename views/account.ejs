<%- include('./partials/header') %>

<% if (locals.success && success.length > 0) { %>
<div id="flash-success" class="fixed top-20 left-1/2 -translate-x-1/2 z-50 flex items-center gap-3 bg-green-500 text-white px-6 py-3 rounded-xl shadow-2xl border border-green-400">
    <i class="ri-checkbox-circle-line text-xl"></i>
    <span class="font-medium"><%= success[0] %></span>
</div>
<script>
    setTimeout(function() {
        const el = document.getElementById('flash-success');
        if (el) { el.style.opacity = '0'; el.style.transition = 'opacity 0.4s'; setTimeout(() => el.remove(), 400); }
    }, 3000);
</script>
<% } %>

<% if (locals.error && error.length > 0) { %>
<div id="flash-error" class="fixed top-20 left-1/2 -translate-x-1/2 z-50 flex items-center gap-3 bg-red-500 text-white px-6 py-3 rounded-xl shadow-2xl border border-red-400">
    <i class="ri-error-warning-line text-xl"></i>
    <span class="font-medium"><%= error[0] %></span>
</div>
<script>
    setTimeout(function() {
        const el = document.getElementById('flash-error');
        if (el) { el.style.opacity = '0'; el.style.transition = 'opacity 0.4s'; setTimeout(() => el.remove(), 400); }
    }, 3000);
</script>
<% } %>

<div class="w-full min-h-screen px-8 lg:px-20 py-28 bg-gray-50">

    <h1 class="text-3xl font-bold text-gray-800 mb-10">My Account</h1>

    <div class="flex flex-col lg:flex-row gap-8">

        <div class="lg:w-1/3">
            <div class="bg-white rounded-2xl shadow-md p-8 border border-gray-100 sticky top-28">

                <div class="flex flex-col items-center mb-8">
                    <div class="h-24 w-24 rounded-full bg-gradient-to-br from-blue-500 to-indigo-600 flex items-center justify-center text-white text-3xl font-bold shadow-lg mb-4">
                        <%= (user.Name || '?').split(' ').map(n => n[0] || '').join('').toUpperCase().slice(0, 2) %>
                    </div>
                    <h2 class="text-2xl font-bold text-gray-800"><%= user.Name || 'User' %></h2>
                    <p class="text-gray-500 text-sm mt-1"><%= user.email %></p>
                </div>

                <div class="border-t border-gray-100 pt-6 space-y-4">
                    <div class="flex items-center gap-3 text-gray-600">
                        <i class="ri-mail-line text-xl text-blue-500"></i>
                        <span class="text-sm break-all"><%= user.email %></span>
                    </div>
                    <div class="flex items-center gap-3 text-gray-600">
                        <i class="ri-shopping-bag-3-line text-xl text-indigo-500"></i>
                        <span class="text-sm"><%= purchaseHistory.length %> order<%= purchaseHistory.length !== 1 ? 's' : '' %> placed</span>
                    </div>
                    <div class="flex items-center gap-3 text-gray-400 mt-4 pt-4 border-t border-gray-100">
                        <i class="ri-fingerprint-line text-lg text-gray-400"></i>
                        <code class="text-xs text-gray-400 font-mono break-all"><%= user._id %></code>
                    </div>
                </div>

                <div class="mt-8 pt-6 border-t border-gray-100 space-y-2">
                    <a href="/shop" class="flex items-center gap-2 w-full px-4 py-3 bg-blue-50 hover:bg-blue-100 text-blue-700 rounded-xl transition-colors text-sm font-medium">
                        <i class="ri-store-2-line"></i> Back to Shop
                    </a>
                    <a href="/user/logout" class="flex items-center gap-2 w-full px-4 py-3 bg-red-50 hover:bg-red-100 text-red-600 rounded-xl transition-colors text-sm font-medium">
                        <i class="ri-logout-box-r-line"></i> Logout
                    </a>
                </div>

            </div>
        </div>

        <div class="lg:w-2/3">

            <div class="flex items-center justify-between mb-6">
                <h2 class="text-xl font-bold text-gray-800">Purchase History</h2>
                <span class="text-sm text-gray-400"><%= purchaseHistory.length %> order<%= purchaseHistory.length !== 1 ? 's' : '' %></span>
            </div>

            <% if (!purchaseHistory || purchaseHistory.length === 0) { %>
                <div class="flex flex-col items-center justify-center bg-white rounded-2xl shadow-sm border border-gray-100 py-20 text-gray-400">
                    <i class="ri-archive-2-line text-6xl mb-4 text-gray-300"></i>
                    <h3 class="text-xl font-semibold text-gray-500 mb-2">No orders yet</h3>
                    <p class="text-sm mb-6 text-gray-400">Your purchase history will appear here after your first order.</p>
                    <a href="/shop" class="px-6 py-3 bg-blue-500 hover:bg-blue-600 text-white font-semibold rounded-full transition-colors shadow-sm">
                        Start Shopping
                    </a>
                </div>
            <% } else { %>
                <div class="space-y-5">
                    <% purchaseHistory.forEach(function(order) { %>
                    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 hover:shadow-md transition-shadow duration-200">

                        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-5">
                            <div>
                                <div class="flex items-center gap-2 mb-1">
                                    <i class="ri-receipt-line text-indigo-500"></i>
                                    <span class="text-xs text-gray-400 font-mono"><%= order.orderId %></span>
                                </div>
                                <p class="text-sm text-gray-500">
                                    <i class="ri-calendar-line mr-1"></i>
                                    <%= new Date(order.orderDate).toLocaleDateString('en-IN', { year: 'numeric', month: 'long', day: 'numeric' }) %>
                                </p>
                            </div>
                            <span class="self-start sm:self-center bg-green-100 text-green-700 font-semibold px-4 py-2 rounded-full text-sm">
                                ₹ <%= order.totalAmount %>
                            </span>
                        </div>

                        <div class="flex flex-wrap gap-4">
                            <% (order.items || []).forEach(function(lineItem) { %>
                            <div class="flex flex-col items-center gap-2 group">
                                <div class="w-16 h-16 rounded-xl overflow-hidden bg-gray-100 border border-gray-200 shadow-sm group-hover:shadow-md transition-shadow duration-200">
                                    <img
                                        src="<%= lineItem.image %>"
                                        alt="<%= lineItem.name %>"
                                        class="w-full h-full object-cover"
                                        onerror="this.src='data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 64 64%22><rect width=%2264%22 height=%2264%22 fill=%22%23e5e7eb%22/></svg>'"
                                    >
                                </div>
                                <span class="text-xs text-gray-500 text-center max-w-[4rem] truncate"><%= lineItem.name %></span>
                                <span class="text-xs font-semibold text-gray-700">₹<%= lineItem.price %></span>
                            </div>
                            <% }) %>
                        </div>

                    </div>
                    <% }) %>
                </div>
            <% } %>

        </div>

    </div>
</div>

<%- include('./partials/footer') %>
